# Generate a random secret:
# https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Base URL for auth callbacks (required to prevent redirect loops)
# Use localhost for browser access, even when running in Docker.
# Must match the origin you use in the browser (scheme + host + port). If Next.js
# prints "using port 3002", set AUTH_URL=http://localhost:3002 in .env.local.
AUTH_URL=http://localhost:3000

# Microsoft 365 / Azure AD Authentication
# M365 OAuth callback URL for E2E tests (defaults to http://localhost:8080 when hosted locally)
# M365_BASE_URL=http://localhost:8080

# Azure AD Credentials (REQUIRED)
# Get these from Azure Portal → Azure Active Directory → App registrations
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Microsoft Graph API URL (optional)
# Automatically set based on M365_BASE_URL:
# - If M365_BASE_URL contains "localhost": uses mock server (http://localhost:8080)
# - Otherwise: uses production Azure Graph API (https://graph.microsoft.com/v1.0)
# Override only if you need a custom Graph API endpoint
# AZURE_GRAPH_API_URL=http://localhost:8080

# API credentials:
PROVIDER_API_KEY=****
PROVIDER_BASE_URL=****
PROVIDER_MODEL=****

# Model configurations (defaults to PROVIDER_MODEL if not specified):
PROVIDER_TITLE_MODEL=****
PROVIDER_ARTIFACT_MODEL=****
PROVIDER_REASONING_MODEL=****

# RAG: Embedding model (gateway model id = "embedding", outputs 1024-dim vectors)
PROVIDER_EMBEDDING_MODEL=embedding

# PostgreSQL database connection:
# Docker (internal network): postgresql://postgres:postgres@postgres:5432/ai_chatbot
# Local development: postgresql://postgres:postgres@localhost:5433/ai_chatbot
#
# If you see "database \"ai_chatbot\" does not exist", create it (adjust host/port/user to match POSTGRES_URL), then run migrations:
#   psql "postgresql://postgres:postgres@localhost:5433/postgres" -c "CREATE DATABASE ai_chatbot;"
#   pnpm db:migrate
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/ai_chatbot

# Crawl4AI API endpoint url (local Docker crawler service):
# Docker (internal network): http://crawl4ai:11235/crawl
# Local development: http://localhost:11235/crawl
CRAWLER_URL=http://localhost:11235/crawl

# Qdrant vector database (RAG over crawled web content):
# Docker (internal network): http://qdrant:6333
# Local development: http://localhost:6340
QDRANT_URL=http://localhost:6340
QDRANT_VECTOR_DIM=1024

# MCP Atlassian server:
# Docker (internal network): http://mcp-atlassian:8000/mcp
# Local development: http://localhost:8000/mcp
ATLASSIAN_MCP=http://localhost:8000/mcp

# Encryption key for sensitive data (API tokens, credentials)
# Generate a random 32-byte hex key: `openssl rand -hex 32`
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=****

# The URL on which the code execution service is running
CODE_EXECUTION_SERVICE_URL=http://localhost:5001

# SearXNG - Privacy-respecting metasearch engine (web search for AI chatbot)
# Docker (internal network): http://searxng:8001
# Local development: http://localhost:8001
SEARXNG_URL=http://localhost:8001

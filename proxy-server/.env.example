# LLM Proxy Server Environment Configuration
# Copy this file to .env and fill in your values
#
# File Priority:
#   .env          - Production/development (gitignored)
#   .env.local    - Local development overrides (gitignored)
#   .env.test     - Test configuration (committed, safe values)
#   .env.example  - This file - template for creating .env

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
#
# Docker (internal network): postgresql://postgres:postgres@postgres:5432/ai_chatbot
# Local development:         postgresql://postgres:postgres@localhost:5433/ai_chatbot
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/ai_chatbot

# Encryption key for API token encryption (32-byte hex string)
# This is the same key used for McpSession encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=<your-32-byte-hex-key>

# Upstream LLM provider base URL
# The proxy forwards requests to this URL
# Should end with /gateway/v1/ or similar
UPSTREAM_BASE_URL=https://ai-api.egt-digital.com/gateway/v1/

# Provider API key for upstream authentication
# This key is sent to the upstream LLM provider
PROVIDER_API_KEY=<your-provider-api-key>

# Provider model name (default: foundation)
PROVIDER_MODEL=foundation

# =============================================================================
# OPTIONAL VARIABLES (with defaults)
# =============================================================================

# Server port (default: 3001)
PORT=3001

# Number of worker threads (default: 4)
WORKER_COUNT=4

# Request queue size (default: 100)
QUEUE_SIZE=100

# Circuit breaker failure threshold (default: 5)
# Number of consecutive failures before circuit opens
CIRCUIT_BREAKER_THRESHOLD=5

# Client timeout in seconds (default: 120)
# Total time a client can wait for response
CLIENT_TIMEOUT_SECS=120

# Upstream timeout in seconds (default: 90)
# Must be less than CLIENT_TIMEOUT_SECS
UPSTREAM_TIMEOUT_SECS=90

# Bind address (default: 0.0.0.0)
# Use 127.0.0.1 for local-only access
BIND_ADDRESS=0.0.0.0

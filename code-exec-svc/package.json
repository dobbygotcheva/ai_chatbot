{
  "name": "code-exec-svc",
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "description": "Code execution service with Docker sandboxing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/",
    "benchmark": "vitest run benchmarks/",
    "load-test": "vitest run benchmarks/load.test.ts"
  },
  "keywords": [
    "code-execution",
    "sandbox",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dockerode": "^4.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "tar-stream": "^3.1.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/dockerode": "^3.3.23",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^20.10.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "ultracite": "^7.0.11",
    "vitest": "^1.6.1"
  }
}

{
  "name": "ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=1048576' next dev --turbo",
    "build": "tsx lib/db/migrate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test:setup": "tsx tests/setup.ts",
    "test:clean": "tsx tests/cleanup.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "lint:commits": "commitlint --from=HEAD~1 --to=HEAD",
    "changelog:draft": "node scripts/generate-changelog-draft.js"
  },
